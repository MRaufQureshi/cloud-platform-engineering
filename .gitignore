# --- Terraform 
# Provider binaries. in .GB in terraform/ folder. Never commit.
**/.terraform/*

# State files: may contain secrets. Belongs in S3, never in git.
*.tfstate
*.tfstate.*
crash.log

# Variable files often hold real values
*.tfvars
!*.tfvars.example

# Backend configs name a bucket in YOUR account.
# Commit the .example, keep the real one local.
backend.*.hcl
!backend.*.hcl.example

# NOTE: .terraform.lock.hcl is NOT ignored — it pins provider versions and
# SHOULD be committed, same reasoning as package-lock.json.

# --- Ansible
# Generated by terraform apply in infra/core. Holds live instance IDs and IPs.
infra/ansible/inventory/hosts.ini

# Holds the database password.
infra/ansible/inventory/group_vars/database_servers.yml
*.retry

# --- Node
node_modules/
npm-debug.log*

# --- Local / generated
*.env
!*.env.example
.DS_Store