# Template. Copy it, then edit:
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is gitignored. CI does not read it — it uses the MY_IP
# repo secret.

# Your public IP (no /32). Find it with:  curl -s https://checkip.amazonaws.com
my_ip = "203.0.113.7"

# Where alarm emails go. AWS sends a confirmation link to this address first.
alert_email = "you@example.com"
