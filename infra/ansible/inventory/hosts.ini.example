# You do not write this file. `terraform apply` in infra/core generates it
# (see infra/core/ansible_inventory.tf) and overwrites it every time.
#
# This example exists so you can see the shape without running Terraform.
# The real hosts.ini is gitignored — it holds live instance IDs and IPs.

[database_servers]
db01-tf ansible_host=10.0.2.87 ansible_user=ec2-user ansible_ssh_private_key_file=~/.ssh/your-key-pair.pem ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ProxyCommand="aws ec2-instance-connect open-tunnel --instance-id i-0123456789abcdef0"'
